# CryFi secrets — copy this file to `.env` and set your own values.
#   cp .env.example .env
#
# `.env` is git-ignored, so real credentials never get committed.
# Docker Compose loads `.env` automatically for ${VAR} substitution.

# Login credentials (also changeable later from the UI).
CRYFI_USER=Admin
CRYFI_PASSWORD=Admin

# Session lifetime in hours.
CRYFI_SESSION_HOURS=12
